# Copy to .env and fill in. Local-first: Ollama (Qwen) needs no key.
# NOTE: the current .env has a malformed line ("api key = ...") — replace it
# with the correctly-named variable below for your provider.

# ── Claude (compile/promote primary, ask fallback) ──
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_ASK_MODEL=claude-haiku-4-5-20251001
CLAUDE_PROMOTE_MODEL=claude-sonnet-4-6

# ── Optional Gemini alt backend ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Ollama (local Qwen, free) ──
OLLAMA_HOST=http://localhost:11434
OLLAMA_KEEP_ALIVE=-1
QWEN_ASK_MODEL=qwen3:8b
QWEN_PROMOTE_MODEL=qwen3:8b

# ── Retrieval (local models, downloaded on first run) ──
# CPU-optimal defaults; upgrade to bge-base + bge-reranker-base on a GPU box.
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_TOP_K=20
RETRIEVAL_TOP_N=6
GRAPH_EXPANSION_HOPS=1
USE_QUERY_REWRITE=0

# ── LLM behaviour ──
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60
SESSION_TTL_MINUTES=30
