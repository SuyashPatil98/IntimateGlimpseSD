# Normalize line endings. Code/scripts that run on Linux (Docker) MUST be LF.
* text=auto

*.py    text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.css   text eol=lf
Dockerfile   text eol=lf
Caddyfile    text eol=lf
brain        text eol=lf

# Binary — never touch
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.apkg  binary
*.npz   binary
