# Copy this to tools/.env and fill in.
# Get token at: https://www.notion.so/my-integrations (create new integration)
# Then SHARE each Notion DB with the integration (... menu -> Connections -> add).
# DB IDs are in the URL: notion.so/<workspace>/<DB_ID>?v=...

NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONCEPTS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ROADMAPS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SESSIONS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INBOX_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
